# BriefDesk configuration. Copy to backend/.env and fill in GROQ_API_KEY.

# --- LLM (Groq: free key at https://console.groq.com/keys) ---
GROQ_API_KEY=
# LLM_MODE=fake runs a scripted offline brain (no key, no network) - handy for a first look and for tests.
LLM_MODE=groq
MODEL_ROUTER=qwen/qwen3.8-27b
MODEL_FAST=openai/gpt-oss-20b
MODEL_LARGE=openai/gpt-oss-120b
# Groq's free tier allows ~8,000 tokens per minute PER MODEL: agents are spread over three models and
# the gateway paces itself to stay under each limit.
MODEL_TOKENS_PER_MINUTE=8000

# --- App ---
ENVIRONMENT=development
# Leave empty locally: a random secret is generated in backend/.secrets/. Set a 32+ char secret in production.
JWT_SECRET=
BOOTSTRAP_ADMIN_EMAIL=admin@briefdesk.dev
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2026
ALLOW_REGISTRATION=true

# --- Research tools ---
# SEARCH_PROVIDER=fake uses offline sample pages (tests / demos without internet)
SEARCH_PROVIDER=ddgs
MCP_CLIENT_ENABLED=true
# MCP servers the researcher can use: copy mcp_servers.example.json to mcp_servers.json (repo root)
MCP_SERVERS_FILE=mcp_servers.json

# --- Limits ---
MAX_CONCURRENT_RUNS=2
RUN_MAX_LLM_CALLS=45
BRIEFS_PER_USER_PER_DAY=30

# --- Logging ---
LOG_FORMAT=text
LOG_FILE=
